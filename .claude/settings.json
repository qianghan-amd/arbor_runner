{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull --rebase *)",
      "Bash(git pull -q --rebase *)",
      "Bash(git push origin main *)",
      "Bash(git push -q origin main *)",
      "Bash(bash scripts/setup_dev.sh *)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(python -m pytest *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git init *)"
    ]
  }
}
