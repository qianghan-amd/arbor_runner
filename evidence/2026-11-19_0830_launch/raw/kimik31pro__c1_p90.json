    "docker exec \\",
    "  -e PORT=8893 \\",
    "  -e MODEL_PATH=\"/hf-hub/hub/models--moonshotai--Kimi-K3.1-Pro/snapshots/6d0a0202956796543364d666ab19c6ad1a494ee1\" \\",
    "  -e MODEL_NAME=\"moonshotai/Kimi-K3.1-Pro\" \\",
    "  -e HF_HUB_OFFLINE=0 \\",
    "  -e HF_HOME=/hf-hub \\",
    "  -e CONCURRENCY=1 \\",
    "  -e NUM_PROMPTS=320 \\",
    "  -e BASELINE_REPEATS=1 \\",
    "  -e BASELINE_SKIP_SIKL=1 \\",
    "  -e BASELINE_OUTPUT=/workspace/exp/runs/before/baseline.json \\",
    "  -e PRIMARY_METRIC=p90_interactivity \\",
    "  -e SECONDARY_METRIC=output_throughput \\",
    "  -e MODEL_PREFIX=kimik31pro -e FRAMEWORK=vllm -e PRECISION=fp4 -e TP=8 -e EP_SIZE=1 \\",
    "  -e DP_ATTENTION=false -e KV_OFFLOADING=none -e SPEC_DECODING=dspark \\",
