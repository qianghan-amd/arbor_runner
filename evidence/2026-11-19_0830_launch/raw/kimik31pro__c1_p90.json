 "launch_container_sh": [
  {
   "path": "/shared_nfs/qiangh/mywork/arbor_kimik31pro/experiments/kimik31pro-c1/launch_container.sh",
   "sha256": "f8e9be3b4c23f12827ee2358984210e4e45ee698229745f196f7933cef41bcc9",
   "size": 1386,
   "mtime": 1794549258,
   "text": [
    "#!/bin/bash",
    "set -euo pipefail",
    "HUB_NL=/mnt/m2m_nobackup/qiangh/arbor_kimik31pro/job_280523/hf-hub",
    "INFX=/shared_nfs/qiangh/mywork/arbor_kimik31pro/codebases/InferenceX",
    "ARBOR=/shared_nfs/qiangh/mywork/arbor_kimik31pro/codebases/Arbor",
    "EXP=/shared_nfs/qiangh/mywork/arbor_kimik31pro/experiments/kimik31pro-c1",
    "SESSIONS=$EXP/sessions",
    "MMAP_CACHE=$EXP/aiperf_mmap_cache",
    "CONTAINER=qh_kimic1",
    "IMAGE_TAG=\"vllm/vllm-openai-rocm:kimi-k31@sha256:4930e37b377b3973384ed5e274dd3cfc18789cfd1f8a98c6cdb5c2dd359ab175\"",
    "",
    "docker rm -f \"$CONTAINER\" >/dev/null 2>&1 || true",
    "render=$(getent group render | cut -d: -f3); video=$(getent group video | cut -d: -f3)",
    "docker run -d --name \"$CONTAINER\" --entrypoint /bin/bash \\",
    "    --network host --ipc host --device /dev/kfd --device /dev/dri \\",
    "    --group-add \"${render:-109}\" --group-add \"${video:-44}\" \\",
    "    --cap-add SYS_PTRACE --security-opt seccomp=unconfined --security-opt label=disable \\",
    "    --shm-size 64g --ulimit memlock=-1 --ulimit stack=67108864 \\",
    "    -v \"$HUB_NL\":/hf-hub \\",
    "    -v \"$INFX\":/workspace/InferenceX \\",
    "    -v \"$ARBOR\":/workspace/Arbor \\",
    "    -v \"$SESSIONS\":/workspace/sessions \\",
    "    -v \"$MMAP_CACHE\":/aiperf_mmap_cache \\",
    "    -v \"$EXP\":/workspace/exp \\",
    "    -e HF_HUB_CACHE=/hf-hub -e HF_HOME=/root/.cache/huggingface -e HF_HUB_OFFLINE=1 \\",
    "    \"$IMAGE_TAG\" -c \"sleep infinity\"",
    "echo \"container started\"",
    "sleep 3",
    "docker ps --filter \"name=$CONTAINER\""
   ]
  }
 ]
}
