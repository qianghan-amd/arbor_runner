    "  -e WEKA_LOADER_OVERRIDE=semianalysis_cc_traces_weka_062126 \\",
    "  -e INFMAX_CONTAINER_WORKSPACE=/workspace/InferenceX \\",
    "  -e AIPERF_REQUIRED_SERVER_METRIC_PREFIX=\"vllm:\" \\",
    "  qh_kimic1 bash /workspace/Arbor/packs/agentx-kimik31pro-c1/validator/baseline.sh \\",
