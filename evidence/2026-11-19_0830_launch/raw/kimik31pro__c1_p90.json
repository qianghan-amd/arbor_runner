 "launch_server_sh": [
  {
   "path": "/shared_nfs/qiangh/mywork/arbor_kimik31pro/experiments/kimik31pro-c1/launch_server.sh",
   "sha256": "2b0f7c49ca35cb99a5f1333d7d1134ace3d9e1fcd4c1738c721d140a60c5b5b1",
   "size": 3235,
   "mtime": 1794549400,
   "text": [
    "#!/bin/bash",
    "set -euo pipefail",
    "export VLLM_ROCM_USE_AITER=\"1\"",
    "export VLLM_ROCM_USE_AITER_MOE_SITUV2=\"1\"",
    "export SAFETENSORS_FAST_GPU=\"1\"",
    "export VLLM_USE_V2_MODEL_RUNNER=\"1\"",
    "export VLLM_FASTSAFETENSORS_QUEUE_SIZE=\"-1\"",
    "export VLLM_USE_BREAKABLE_CUDAGRAPH=\"0\"",
    "export VLLM_ROCM_AITER_MLA_ASM_PADDING=\"asm\"",
    "export VLLM_ROCM_AITER_MLA_DCP_VERIFY=\"asm\"",
    "export VLLM_ROCM_DCP_AITER_ALLGATHER=\"1\"",
    "export VLLM_ROCM_USE_AITER_FLYDSL_SPARSE_MLA=\"1\"",
    "export AITER_FLYDSL_SPARSE_MLA=\"1\"",
    "export VLLM_ROCM_DSA_DCP_GLOBAL_KEY_PREFILL=\"1\"",
    "export VLLM_ROCM_DSA_DCP_ROWSHARD_PREFILL=\"1\"",
    "export VLLM_USE_DIRECT_DCP_A2A=\"0\"",
    "export VLLM_USE_DIRECT_DCP_Q_GATHER=\"0\"",
    "export VLLM_USE_DIRECT_DCP_KV_GATHER=\"0\"",
    "export VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"NONE\"",
    "export AITER_FLYDSL_STAGE2_FP8=\"0\"",
    "export AITER_BF16_FP8_MOE_BOUND=\"0\"",
    "export HSA_NO_SCRATCH_RECLAIM=\"1\"",
    "export THP_MEM_ALLOC_ENABLE=\"1\"",
    "export VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=\"1200\"",
    "export PYTHONNOUSERSITE=\"1\"",
    "export VLLM_ENGINE_READY_TIMEOUT_S=\"7200\"",
    "export PYTHONHASHSEED=\"42\"",
    "export AIPERF_HTTP_TCP_USER_TIMEOUT=\"900000\"",
    "export AIPERF_REQUIRED_SERVER_METRIC_PREFIX=\"vllm:\"",
    "export MODEL_PREFIX=\"kimik31pro\"",
    "export FRAMEWORK=\"vllm\"",
    "export PRECISION=\"fp4\"",
    "export SPEC_DECODING=\"dspark\"",
    "export RUNNER_TYPE=\"mi355x-amds\"",
    "export TP=\"8\"",
    "export EP_SIZE=\"1\"",
    "export DP_ATTENTION=\"false\"",
    "export KV_OFFLOADING=\"none\"",
    "export DURATION=\"3600\"",
    "export WEKA_LOADER_OVERRIDE=\"semianalysis_cc_traces_weka_062126\"",
    "export INFMAX_CONTAINER_WORKSPACE=\"/workspace/InferenceX\"",
    "export PRIMARY_METRIC=\"p90_interactivity\"",
    "export SECONDARY_METRIC=\"output_throughput\"",
    "export HF_HUB_CACHE=\"/hf-hub\"",
    "export HF_HOME=\"/root/.cache/huggingface\"",
    "export HF_HUB_OFFLINE=\"1\"",
    "cd /workspace",
    "echo '[launch] starting vllm serve' >&2",
    "vllm serve \"/hf-hub/hub/models--moonshotai--Kimi-K3.1-Pro/snapshots/6d0a0202956796543364d666ab19c6ad1a494ee1\" --port 8893 --served-model-name \"moonshotai/Kimi-K3.1-Pro\" --tensor-parallel-size 8 --decode-context-parallel-size 8 --dcp-comm-backend a2a --cp-kv-cache-interleave-size 1 --trust-remote-code --moe-backend auto --seed 7 --language-model-only --load-format fastsafetensors --enable-auto-tool-choice --tool-call-parser kimi_k3 --reasoning-parser kimi_k3 --max-model-len 1048576 --enable-prefix-caching --prefix-match-unit 64 --kv-cache-dtype fp8 --mamba-ssm-cache-dtype float32 --attention-config '{\"indexer_kv_dtype\":\"mxfp4\"}' --additional-config '{\"decode_backend\":\"latency_specialized\",\"kda_prefill_backend\":\"fused\"}' --max-num-batched-tokens 16384 --gpu-memory-utilization 0.90 --stream-interval 10 --disable-uvicorn-access-log --max-num-seqs 1 --compilation-config '{\"mode\":3,\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"max_cudagraph_capture_size\":16,\"custom_ops\":[\"+fused_rms_norm_gated\"],\"cudagraph_capture_sizes\":[2,4,6,8,10,12,14,16]}' --speculative-config '{\"method\":\"dspark\",\"model\":\"/hf-hub/hub/models--Inferact--Kimi-K3.1-Pro-DSpark-preview/snapshots/5e654fbe920278f228a89519b06b2680aa56480f\",\"num_speculative_tokens\":7,\"attention_backend\":\"ROCM_AITER_MLA\",\"kv_cache_dtype\":\"fp8\",\"draft_sample_method\":\"probabilistic\",\"rejection_sample_method\":\"block\"}' > /workspace/exp/logs/server.log 2>&1 &",
    "echo $! > /workspace/exp/logs/server.pid",
    "echo '[launch] pid:' $(cat /workspace/exp/logs/server.pid)"
   ]
  }
