{
 "prepare_sh": [
  {
   "path": "/shared_nfs/qiangh/mywork/arbor_dsv41flash/experiments/glm52-c16-tput/prepare.sh",
   "sha256": "5315dcf00750751142c7d61db0fb5e31fe6f0425d062154ac960c1cef6911c6c",
   "size": 11122,
   "mtime": 1794200873,
   "text": [
    "#!/bin/bash",
    "# Provision the node for the glm52-c16-tput campaign. Idempotent; run on the GPU node through the",
    "# hold job's ctrl/ directory. Same steps as experiments/dsv41f-c32-tput/prepare.sh, for SGLang:",
    "#   1. node checks (docker, GPU memory, foreign containers) -> logs/node_facts.txt",
    "#   2. the CI image, pulled by digest and checked",
    "#   2b. the weights snapshot copied to node-local NVMe and sha-verified (falls back to NFS)",
    "#   3. the container: weights, InferenceX and Arbor checkouts, sessions",
    "#   4. stack versions -> logs/stack_versions.txt",
    "#   5. the sglang package tree as its own git repository with a baseline commit (workspace_root)",
    "#   6. lm_eval (every installed package pinned) and the aiperf environment",
    "#   7. ruppell (profiler skill), not fatal",
    "set -uo pipefail",
    ". \"$(dirname \"$0\")/env.sh\"",
    "",
    "log \"prepare on $(hostname -s) job=${SLURM_JOB_ID:-none}\"",
    "",
    "# ---- 1. node --------------------------------------------------------------------------------",
    "docker info >/dev/null 2>&1 || die \"no working docker daemon\"",
    "{",
    "    echo \"# node facts, $(date -Is)\"",
    "    hostname; uname -r",
    "    rocm-smi --showproductname 2>/dev/null | grep -E \"GPU\\[\" | head -8",
    "    for f in /sys/class/drm/card*/device/mem_info_vram_used; do echo \"$f $(cat \"$f\")\"; done 2>/dev/null",
    "    echo \"# containers on this node before ours:\"; docker ps --format '{{.Names}} {{.Image}} {{.Status}}'",
    "    free -g | head -2; nproc",
    "    df -h -l -x tmpfs -x devtmpfs -x overlay 2>/dev/null",
    "} > \"$LOGS/node_facts.txt\" 2>&1",
    "log \"node facts -> $LOGS/node_facts.txt\"",
    "",
    "# ---- 2. image, by digest ------------------------------------------------------------------------",
    "if ! docker image inspect \"$IMAGE_REF\" >/dev/null 2>&1; then",
    "    log \"pulling $IMAGE_REF\"",
    "    mkdir -p /tmp/qiangh_docker_anon   # anonymous pull: the user's Docker Hub token has expired",
    "    DOCKER_CONFIG=/tmp/qiangh_docker_anon docker pull \"$IMAGE_REF\" 2>&1 | tail -3",
    "fi",
    "docker image inspect \"$IMAGE_REF\" >/dev/null 2>&1 || die \"image $IMAGE_REF unavailable\"",
    "docker tag \"$IMAGE_REF\" \"$IMAGE_TAG\"",
    "digests=$(docker image inspect --format '{{join .RepoDigests \" \"}}' \"$IMAGE_TAG\")",
    "case \"$digests\" in *\"$IMAGE_DIGEST\"*) log \"image ok: $IMAGE_TAG = $IMAGE_DIGEST\";; *) die \"image digest mismatch: $digests\";; esac",
    "",
    "# ---- 2b. weights on node-local NVMe ------------------------------------------------------------",
    "SNAP_HOST=$HF_HUB_HOST${MODEL_C#/hf-hub}",
    "REV=$(basename \"$MODEL_C\")",
    "dest=$NODE_LOCAL/weights/$REV",
    "LOCAL_SNAP=\"\"",
    "mkdir -p \"$NODE_LOCAL/weights\" \"$MMAP_CACHE\" && chmod 777 \"$MMAP_CACHE\"",
    "if [ -e \"$dest/COMPLETE\" ]; then",
    "    LOCAL_SNAP=$dest; log \"weights: local copy present at $dest\"",
    "else",
    "    need=$(( $(du -sbL \"$SNAP_HOST\" | cut -f1) + 50 * 1024**3 ))",
    "    avail=$(df -B1 --output=avail \"$NODE_LOCAL\" | tail -1)",
    "    if [ \"$avail\" -ge \"$need\" ]; then",
    "        log \"weights: copying $SNAP_HOST -> $dest ($((need / 1024**3)) GiB incl. headroom; $((avail / 1024**3)) GiB free)\"",
    "        t0=$(date +%s)",
    "        rm -rf \"$dest\" \"$dest.tmp\" && mkdir -p \"$dest.tmp\"",
    "        ( cd \"$SNAP_HOST\" && find . -type l -printf '%P\\n' ) > \"$LOGS/weights_files.txt\"",
    "        ( cd \"$SNAP_HOST\" && xargs -a \"$LOGS/weights_files.txt\" -P 16 -I{} sh -c \\",
    "            'mkdir -p \"$1/$(dirname \"$2\")\" && cp -L \"$2\" \"$1/$2\"' _ \"$dest.tmp\" {} )",
    "        # LFS blobs are named by the sha256 of their content; small git files by sha1 (cmp).",
    "        bad=$( cd \"$SNAP_HOST\" && xargs -a \"$LOGS/weights_files.txt\" -P 16 -I{} sh -c '",
    "            h=$(basename \"$(readlink \"$2\")\")",
    "            if [ ${#h} -eq 64 ]; then [ \"$(sha256sum < \"$1/$2\" | cut -c1-64)\" = \"$h\" ] || echo \"$2\"",
    "            else cmp -s \"$2\" \"$1/$2\" || echo \"$2\"; fi' _ \"$dest.tmp\" {} )",
    "        nloc=$(find \"$dest.tmp\" -type f | wc -l); nsrc=$(wc -l < \"$LOGS/weights_files.txt\")",
    "        if [ -z \"$bad\" ] && [ \"$nloc\" -eq \"$nsrc\" ]; then",
    "            mv \"$dest.tmp\" \"$dest\" && echo \"$REV $(date -Is)\" > \"$dest/COMPLETE\"",
    "            LOCAL_SNAP=$dest; log \"weights: $nloc files copied and verified in $(( $(date +%s) - t0 )) s\"",
    "        else",
    "            log \"weights: verify failed ($nloc/$nsrc files; bad: $(echo $bad | head -c 300)); using NFS\"",
    "            rm -rf \"$dest.tmp\"",
    "        fi",
    "    else",
    "        log \"weights: $((avail / 1024**3)) GiB free on $NODE_LOCAL < $((need / 1024**3)) GiB; using NFS\"",
    "    fi",
    "fi",
    "echo \"${LOCAL_SNAP:-$SNAP_HOST} -> $MODEL_C ($(date -Is), $(hostname -s))\" > \"$LOGS/weights_source.txt\"",
    "WEIGHTS_MOUNT=()",
    "[ -n \"$LOCAL_SNAP\" ] && WEIGHTS_MOUNT=(-v \"$LOCAL_SNAP\":\"$MODEL_C\":ro)",
    "",
    "# ---- 3. container -------------------------------------------------------------------------------",
    "mkdir -p \"$SESSIONS\" && chmod 777 \"$SESSIONS\"",
    "if [ \"$(docker inspect -f '{{.State.Running}}' \"$CONTAINER\" 2>/dev/null)\" != true ]; then",
    "    docker rm -f \"$CONTAINER\" >/dev/null 2>&1",
    "    render=$(getent group render | cut -d: -f3); video=$(getent group video | cut -d: -f3)",
    "    # -w /workspace (CI's cwd): the image's WORKDIR /sgl-workspace holds the sglang checkout, and from",
    "    # there `import sglang` resolves to an empty namespace package instead of the installed one.",
    "    docker run -d --init --name \"$CONTAINER\" --entrypoint /bin/bash -w /workspace \\",
    "        --network host --ipc host --device /dev/kfd --device /dev/dri \\",
    "        --group-add \"${render:-109}\" --group-add \"${video:-44}\" \\",
    "        --cap-add SYS_PTRACE --cap-add IPC_LOCK --security-opt seccomp=unconfined --security-opt label=disable \\",
    "        --shm-size 64g --ulimit memlock=-1 --ulimit stack=67108864 \\",
    "        -v \"$HF_HUB_HOST\":/hf-hub \"${WEIGHTS_MOUNT[@]}\" \\",
    "        -v \"$INFX\":/workspace/InferenceX \\",
    "        -v \"$ARBOR\":/workspace/Arbor \\",
    "        -v \"$SESSIONS\":/workspace/sessions \\",
    "        -v \"$MMAP_CACHE\":/aiperf_mmap_cache \\",
    "        -v \"$EXP\":/workspace/exp \\",
    "        -v \"$ARBOR/.claude/skills/profiler/ruppell\":/ruppell:ro \\",
    "        -e HF_HUB_CACHE=/hf-hub -e HF_HOME=/root/.cache/huggingface -e RUPPELL_BUILD=/root/ruppell-work/build \\",
    "        \"$IMAGE_TAG\" -c \"sleep infinity\" >/dev/null || die \"docker run failed\"",
    "    log \"container $CONTAINER started\"",
    "else",
    "    log \"container $CONTAINER already running\"",
    "fi",
    "n=0",
    "for i in $(seq 1 30); do",
    "    n=$(docker exec \"$CONTAINER\" bash -c \"ls $MODEL_C/*.safetensors 2>/dev/null | wc -l\")",
    "    [ \"$n\" -eq \"$N_SHARDS\" ] && break; sleep 2",
    "done",
    "[ \"$n\" -eq \"$N_SHARDS\" ] || die \"$n/$N_SHARDS shards visible at $MODEL_C\"",
    "log \"$N_SHARDS shards visible at $MODEL_C\"",
    "",
    "# ---- 4. versions ----------------------------------------------------------------------------------",
    "docker exec \"$CONTAINER\" bash -c '",
    "  echo \"# stack versions, $(date -Is)\"",
    "  cat /opt/rocm/.info/version 2>/dev/null | sed \"s/^/rocm: /\"",
    "  python3 -c \"import sglang, torch, importlib.metadata as m; print(\\\"sglang:\\\", m.version(\\\"sglang\\\"), sglang.__file__); print(\\\"torch:\\\", torch.__version__, torch.version.hip)\"",
    "  python3 -c \"import aiter; print(\\\"aiter:\\\", aiter.__file__)\" 2>&1 | tail -1",
    "  pip list 2>/dev/null | grep -iE \"^(sglang|sgl.kernel|torch|aiter|amd-aiter|triton|transformers|tilelang|lm.eval) \"",
    "  env | grep -E \"^(SGLANG|AITER|HIP|HSA|ROCR|PYTORCH|NCCL|RCCL)_\" | sort",
    "' > \"$LOGS/stack_versions.txt\" 2>&1",
    "log \"stack versions -> $LOGS/stack_versions.txt: $(grep -E '^(rocm|sglang|aiter):' \"$LOGS/stack_versions.txt\" | tr '\\n' ' ')\"",
    "SGL_DIR=$(docker exec \"$CONTAINER\" python3 -c 'import os, sglang; print(os.path.dirname(sglang.__file__))' 2>/dev/null | tail -1)",
    "case \"$SGL_DIR\" in /*/sglang) ;; *) die \"sglang does not import as a regular package in $CONTAINER (got '$SGL_DIR')\";; esac",
    "\"$PY\" -c 'import json,sys; p=sys.argv[1]; c=json.load(open(p)); c[\"workspace_root\"]=sys.argv[2]; json.dump(c, open(p,\"w\"), indent=2)' \"$CONFIG\" \"$SGL_DIR\"",
    "echo \"$SGL_DIR\" > \"$EXP/WORKSPACE_ROOT\"",
    "WORKSPACE_ROOT=$SGL_DIR",
    "log \"workspace_root = $SGL_DIR\"",
    "AITER_PATH=$(docker exec \"$CONTAINER\" python3 -c 'import os, aiter; print(os.path.dirname(aiter.__file__))' 2>/dev/null | tail -1)",
    "if [ -n \"$AITER_PATH\" ]; then",
    "    \"$PY\" - \"$CONFIG\" \"$AITER_PATH\" <<'PYEOF'",
    "import json, sys",
    "p, path = sys.argv[1], sys.argv[2]",
    "c = json.load(open(p))",
    "pk = c.setdefault(\"editable_packages\", [])",
    "if not any(e.get(\"name\") == \"aiter\" for e in pk):",
    "    pk.append({\"name\": \"aiter\", \"path\": path, \"rebuild\": None})",
    "    json.dump(c, open(p, \"w\"), indent=2)",
    "print(f\"[prepare] editable: aiter at {path}\")",
    "PYEOF",
    "fi",
    "",
    "# ---- 5. the sglang package tree as its own git repository ---------------------------------------",
    "# A nested repository at the package dir: the image's checkout above it (if any) is left alone,",
    "# and git commands run in workspace_root find this .git first.",
    "docker exec \"$CONTAINER\" bash -c \"",
    "  cd $WORKSPACE_ROOT || exit 1",
    "  command -v git >/dev/null || { echo 'no git in the image'; exit 1; }",
    "  [ -d .git ] && { echo \\\"repo present at \\$(git rev-parse --short HEAD)\\\"; exit 0; }",
    "  git init -q . && git config user.email arbor@local && git config user.name Arbor && git config core.fileMode false",
    "  printf '__pycache__/\\n*.pyc\\n*.so\\n' > .git/info/exclude",
    "  git add -A 2>/dev/null && git commit -q -m 'baseline: sglang as shipped in $IMAGE_TAG'",
    "  echo \\\"initialised \\$(git ls-files | wc -l) files at \\$(git rev-parse --short HEAD)\\\"",
    "\" 2>&1 | sed 's/^/[prepare] git: /'",
    "docker exec \"$CONTAINER\" bash -c \"cd $WORKSPACE_ROOT && [ -d .git ] && git rev-parse --short HEAD\" >/dev/null 2>&1 || die \"git baseline failed\"",
    "",
    "# ---- 6. lm_eval (correctness) and aiperf (bench) ----------------------------------------------",
    "if ! docker exec \"$CONTAINER\" bash -c 'command -v lm_eval >/dev/null'; then",
    "    log \"installing lm_eval with every installed package pinned\"",
    "    docker exec \"$CONTAINER\" bash -c '",
    "      pip freeze 2>/dev/null | grep -v -E \"^-e |@ file:\" > /tmp/pins.txt",
    "      pip install -q \"lm_eval[api]\" -c /tmp/pins.txt 2>&1 | tail -3",
    "      pip freeze 2>/dev/null | grep -v -E \"^-e |@ file:\" > /tmp/pins_after.txt",
    "      echo \"changed or removed pins: $(comm -23 <(sort /tmp/pins.txt) <(sort /tmp/pins_after.txt) | wc -l)\"",
    "    ' 2>&1 | sed 's/^/[prepare] lm_eval: /'",
    "fi",
    "docker exec \"$CONTAINER\" bash -c 'command -v lm_eval >/dev/null' || die \"lm_eval not installed\"",
    "docker exec \"$CONTAINER\" bash -c '",
    "  export INFMAX_CONTAINER_WORKSPACE=/workspace/InferenceX AIPERF_RUNTIME_DIR=/root/inferencex-agentic",
    "  source /workspace/InferenceX/benchmarks/benchmark_lib.sh",
    "  if [ -x \"$AIPERF_CLI\" ] && [ -f \"$AIPERF_RUNTIME_DIR/.ready\" ]; then echo \"aiperf present\"; exit 0; fi",
    "  install_agentic_deps && touch \"$AIPERF_RUNTIME_DIR/.ready\" && \"$AIPERF_CLI\" --version 2>&1 | tail -1",
    "' 2>&1 | tail -3 | sed 's/^/[prepare] aiperf: /'",
    "docker exec \"$CONTAINER\" bash -c 'test -f /root/inferencex-agentic/.ready' || die \"aiperf environment not ready\"",
    "",
    "# ---- 7. ruppell (profiler skill), not fatal -----------------------------------------------------",
    "docker exec \"$CONTAINER\" bash -c '",
    "  [ -f /ruppell/runtime/build.sh ] || { echo \"no vendored ruppell at /ruppell\"; exit 0; }",
    "  mkdir -p /root/ruppell-work && bash /ruppell/runtime/build.sh > /root/ruppell-work/build.log 2>&1 \\",
    "    && bash /ruppell/runtime/build_cpu_ops.sh >> /root/ruppell-work/build.log 2>&1; echo \"rc=$? (RUPPELL_BUILD=$RUPPELL_BUILD)\"",
    "' 2>&1 | tail -1 | sed 's/^/[prepare] ruppell build: /'",
    "",
    "touch \"$EXP/PREPARED\"",
    "log \"prepare done\""
   ]
  }
 ],
 "stage1_sh": [
  {
   "path": "/shared_nfs/qiangh/mywork/arbor_dsv41flash/experiments/glm52-c16-tput/stage1.sh",
   "sha256": "2aeb9d94fe6b1e643d8e27e0f91ffbc66b171acd326dad68586a4a7126d3939c",
   "size": 3300,
   "mtime": 1794195040,
   "text": [
    "#!/bin/bash",
    "# The glm52-c16-tput pipeline, each step validated before the next (as dsv41f-c32-tput's stage1.sh):",
    "#   prepare -> smoke (C16, 300 s, 50 GSM8K) -> CI-aligned reference (C16, 3600 s, vs CI run 31501371582;",
    "#   also the campaign's \"before\" number) -> the bar (C16, 2 cold 600 s replays, full GSM8K)",
    "#   -> calibrate bands, set GSM8K_MIN -> campaign",
    "# A step that fails stops the pipeline. A finished step is skipped by its output file.",
    "set -uo pipefail",
    ". /shared_nfs/qiangh/mywork/arbor_dsv41flash/experiments/glm52-c16-tput/env.sh",
    "cd \"$EXP\" || exit 1",
    "export ARBOR PYTHONPATH=$ARBOR",
    "mkdir -p \"$BASELINE_DIR\"",
    "",
    "[ -f \"$EXP/PREPARED\" ] || bash \"$EXP/prepare.sh\" || die \"prepare failed\"",
    "",
    "measure() {  # tag duration replays gsm8k out [extra...]",
    "    local tag=$1 dur=$2 reps=$3 gsm=$4 out=$5; shift 5",
    "    [ -s \"$out\" ] && { log \"$tag: $out exists, skipped\"; return 0; }",
    "    log \"$tag: ${reps} x ${dur} s replay(s), GSM8K $gsm\"",
    "    \"$PY\" \"$EXP/tools/measure.py\" --config \"$CONFIG\" --sessions \"$SESSIONS\" --tag \"$tag\" \\",
    "        --duration \"$dur\" --replays \"$reps\" --gsm8k \"$gsm\" --out \"$out\" \"$@\"",
    "}",
    "",
    "measure smoke 300 1 50 \"$BASELINE_DIR/smoke_c16_d300.json\" --unsafe-override || die \"smoke failed\"",
    "measure ci_ref 3600 1 0 \"$BASELINE_DIR/ci_ref_c16_d3600.json\" || die \"CI-aligned reference failed\"",
    "\"$PY\" - \"$BASELINE_DIR/ci_ref_c16_d3600.json\" <<'PYEOF'",
    "import json, sys",
    "r = json.load(open(sys.argv[1]))",
    "ci = 6379.42438   # CI run 31501371582, TP4 C16 tput_per_gpu",
    "v = r[\"mean\"]",
    "print(f\"[stage1] ci_ref C16: {v:.2f} tok/s/GPU vs CI {ci:.2f} ({100 * (v / ci - 1):+.2f} %)\")",
    "PYEOF",
    "measure bar 600 2 1319 \"$BASELINE_DIR/baseline_c16_d600.json\" || die \"the bar failed\"",
    "",
    "# Bands from the measured spread (Arbor's calibrate_baseline.py); GSM8K_MIN = full score - 3 SE(400).",
    "if [ ! -f \"$BASELINE_DIR/CALIBRATED\" ]; then",
    "    \"$PY\" \"$ARBOR/scripts/dsv41-campaign/calibrate_baseline.py\" \"$BASELINE_DIR/baseline_c16_d600.json\" \\",
    "        \"$CONFIG\" \"$PACK_YAML\" || die \"calibration failed\"",
    "    \"$PY\" - \"$BASELINE_DIR/baseline_c16_d600.json\" \"$CONFIG\" <<'PYEOF' || exit 1",
    "import json, math, sys",
    "rec, cfg_p = json.load(open(sys.argv[1])), sys.argv[2]",
    "s = (rec.get(\"correctness\") or {}).get(\"score\")",
    "if not isinstance(s, (int, float)) or s <= 0:",
    "    sys.exit(f\"no full-GSM8K score in the bar record: {rec.get('correctness')}\")",
    "n = 400",
    "floor = round(max(0.0, s - 3 * math.sqrt(s * (1 - s) / n)), 4)",
    "cfg = json.load(open(cfg_p))",
    "cfg[\"server_env\"][\"GSM8K_MIN\"] = str(floor)",
    "cfg[\"_gsm8k_note\"] = (f\"GSM8K_MIN {floor} = this node's full-set baseline score {s:.4f} (1319 questions, \"",
    "                      f\"simulated MTP acceptance on, as the throughput runs serve) less 3 standard errors \"",
    "                      f\"of a {n}-question subset.\")",
    "json.dump(cfg, open(cfg_p, \"w\"), indent=2)",
    "print(f\"[stage1] GSM8K_MIN <- {floor} (baseline {s:.4f})\")",
    "PYEOF",
    "    # The campaign runs the full 24 h: no early stop on a target (as for dsv41f-c32-tput).",
    "    \"$PY\" - \"$CONFIG\" <<'PYEOF'",
    "import json, sys",
    "p = sys.argv[1]; c = json.load(open(p))",
    "if \"target\" in c:",
    "    c[\"_target_removed\"] = {**c.pop(\"target\"), \"_why\": \"the user asks for the full 24 h campaign\"}",
    "    json.dump(c, open(p, \"w\"), indent=2); print(\"[stage1] target removed: run the full 24 h\")",
    "PYEOF",
    "    touch \"$BASELINE_DIR/CALIBRATED\"",
    "fi",
    "",
    "exec bash \"$EXP/campaign.sh\""
   ]
  }
 ],
 "measure_py": [
  {
   "path": "/shared_nfs/qiangh/mywork/arbor_dsv41flash/experiments/glm52-c16-tput/tools/measure.py",
   "sha256": "10f504112518ed000e603c2c00cfe91bff0df932319c975e82abe65f40c5754a",
   "size": 10219,
   "mtime": 1794200872,
   "text": [
    "#!/usr/bin/env python3",
    "\"\"\"Cold replays of the campaign's bench, outside the Arbor loop: the smoke test, the bar and the",
    "CI-aligned reference.",
    "",
    "From Arbor's scripts/muse-campaign/baseline_muse.py, with two changes: the server is launched with",
    "Arbor's own command (arbor.frameworks: the config's server_env, its GPU mask, its flags, byte for",
    "byte what the harness runs), and the metrics are the pack's (objective.metric and",
    "secondary_metric, read from pack.yaml) instead of hard-coded names.",
    "",
    "For each replay: stop any server, start one, wait for /health, run the pack's bench with",
    "DURATION set, stop the server. The correctness script runs once, after the first replay, with",
    "GSM8K_LIMIT set. The record has the keys Arbor seeds its bar from (`mean`, `runs`,",
    "`mean_secondary`) and calibrate_baseline.py reads (`relative_spread`, `runs_secondary`,",
    "`relative_spread_secondary`).",
    "",
    "Run on the GPU node, with the container up:",
    "    PYTHONPATH=<arbor> measure.py --config <cfg> --sessions <host dir at /workspace/sessions> \\",
    "        --tag <name> --duration 600 --replays 2 [--gsm8k 1319] --out <record.json>",
    "\"\"\"",
    "",
    "from __future__ import annotations",
    "",
    "import argparse",
    "import json",
    "import os",
    "import shlex",
    "import socket",
    "import statistics",
    "import subprocess",
    "import sys",
    "import time",
    "from pathlib import Path",
    "",
    "import yaml",
    "",
    "from arbor import frameworks",
    "",
    "",
    "def log(msg: str) -> None:",
    "    print(f\"[measure] {time.strftime('%H:%M:%S')} {msg}\", flush=True)",
    "",
    "",
    "def dexec(container: str, cmd: str, env: dict | None = None, timeout: float | None = None):",
    "    args = [\"docker\", \"exec\"]",
    "    for k, v in (env or {}).items():",
    "        args += [\"-e\", f\"{k}={v}\"]",
    "    return subprocess.run(args + [container, \"bash\", \"-c\", cmd], capture_output=True, text=True,",
    "                          timeout=timeout)",
    "",
    "",
    "def wait_gpus_clean(limit: float = 0.10, timeout: float = 900) -> None:",
    "    \"\"\"Every GPU on the node at <= 10 % VRAM (the CI recipe's own pre-launch check). Read from the",
    "    host's amdgpu sysfs: it also sees memory held by other containers on this node.\"\"\"",
    "    t0 = time.time()",
    "    while True:",
    "        worst = 0.0",
    "        for d in Path(\"/sys/class/drm\").glob(\"card*/device\"):",
    "            try:",
    "                used = int((d / \"mem_info_vram_used\").read_text())",
    "                total = int((d / \"mem_info_vram_total\").read_text())",
    "            except (OSError, ValueError):",
    "                continue",
    "            worst = max(worst, used / total)",
    "        if worst <= limit:",
    "            return",
    "        if time.time() - t0 > timeout:",
    "            raise RuntimeError(f\"GPUs not clean after {timeout:.0f} s: max VRAM {worst:.0%}\")",
    "        log(f\"waiting for GPU memory reclaim: max VRAM {worst:.0%}\")",
    "        time.sleep(10)",
    "",
    "",
    "def stop_server(container: str, cfg: dict) -> None:",
    "    if frameworks.get(cfg).name == \"sglang\":",
    "        # SIGTERM, then wait: SGLang frees its KFD memory only on a clean exit (arbor/frameworks/sglang.py).",
    "        dexec(container, \"pkill -f '[s]glang.launch_server'; true\")",
    "        for _ in range(36):",
    "            time.sleep(5)",
    "            if dexec(container, \"ps -eo stat,cmd | awk '$1 !~ /^Z/' | grep -q '[s]glang'\").returncode != 0:",
    "                break",
    "        else:",
    "            log(\"WARNING: sglang processes alive 180 s after SIGTERM; SIGKILL\")",
    "            dexec(container, \"pkill -9 -f '[s]glang'; true\")",
    "    else:",
    "        dexec(container, 'pkill -f \"[v]llm serve\"; sleep 10; pkill -9 -f \"[V]LLM::\"; pkill -9 -f [E]ngineCore; true')",
    "        time.sleep(10)",
    "    wait_gpus_clean()",
    "",
    "",
    "def start_server(container: str, cfg: dict, log_path: str, wait_s: int) -> float:",
    "    fw = frameworks.get(cfg)",
    "    env = fw.device_env(dict(cfg.get(\"server_env\", {})), str(cfg.get(\"gpu_ids\", \"\")))",
    "    env.update(fw.extra_env(cfg.get(\"server_flags\", \"\")))",
    "    cmd = fw.launch_cmd(cfg, env, cfg.get(\"server_flags\", \"\"), log_path=log_path)",
    "    log(f\"launch: {cmd[:400]}...\")",
    "    t0 = time.time()",
    "    dexec(container, cmd)",
    "    port = cfg[\"port\"]",
    "    while time.time() - t0 < wait_s:",
    "        time.sleep(20)",
    "        if dexec(container, f\"curl -sf http://127.0.0.1:{port}/health\").returncode == 0:",
    "            return time.time() - t0",
    "        if dexec(container, f\"pgrep -f '{fw.server_pattern}'\").returncode != 0:",
    "            tail = dexec(container, f\"tail -20 {shlex.quote(log_path)}\").stdout",
    "            raise RuntimeError(f\"server exited during start; {log_path} ends:\\n{tail}\")",
    "    raise RuntimeError(f\"server not healthy after {wait_s} s\")",
    "",
    "",
    "def run_script(container: str, cfg: dict, script: str, extra: dict, timeout: int) -> int:",
    "    env = {**cfg.get(\"server_env\", {}), \"PORT\": cfg[\"port\"], \"MODEL_PATH\": cfg[\"model_path\"],",
    "           \"MODEL_NAME\": cfg[\"model_name\"], **extra}",
    "    p = dexec(container, f\"bash {shlex.quote(script)}\", env={k: str(v) for k, v in env.items()},",
    "              timeout=timeout)",
    "    for line in (p.stdout + p.stderr).splitlines()[-12:]:",
    "        print(f\"[measure]   {line}\", flush=True)",
    "    return p.returncode",
    "",
    "",
    "def main() -> int:",
    "    ap = argparse.ArgumentParser()",
    "    ap.add_argument(\"--config\", required=True)",
    "    ap.add_argument(\"--sessions\", required=True, help=\"host dir mounted at the config's session_mount\")",
    "    ap.add_argument(\"--tag\", required=True)",
    "    ap.add_argument(\"--duration\", type=int, required=True, help=\"the replay window, seconds\")",
    "    ap.add_argument(\"--replays\", type=int, default=1)",
    "    ap.add_argument(\"--gsm8k\", type=int, default=0, help=\"GSM8K questions after replay 1 (0: none)\")",
    "    ap.add_argument(\"--unsafe-override\", action=\"store_true\", help=\"AIPERF_UNSAFE_OVERRIDE for a short smoke window\")",
    "    ap.add_argument(\"--boot-timeout\", type=int, default=3600)",
    "    ap.add_argument(\"--out\", required=True)",
    "    a = ap.parse_args()",
    "",
    "    cfg = json.load(open(a.config))",
    "    pack = yaml.safe_load(open(Path(cfg[\"bench_script\"].replace(\"/workspace/Arbor\", os.environ[\"ARBOR\"])).parents[1] / \"pack.yaml\"))",
    "    obj = pack[\"objective\"]",
    "    primary, secondary = obj[\"metric\"], obj[\"measurement\"].get(\"secondary_metric\")",
    "    container = cfg[\"docker_container\"]",
    "    mount = cfg.get(\"session_mount\", \"/workspace/sessions\")",
    "    host_dir = Path(a.sessions) / f\"measure_{a.tag}\"",
    "    host_dir.mkdir(parents=True, exist_ok=True)",
    "    os.chmod(host_dir, 0o777)",
    "    cdir = f\"{mount}/measure_{a.tag}\"",
    "    bench_timeout = max(int(cfg.get(\"bench_timeout\", 5400)), a.duration + 3600)",
    "",
    "    runs, runs_sec, boots, details, correctness = [], [], [], [], None",
    "    for r in range(1, a.replays + 1):",
    "        for attempt in (1, 2):",
    "            try:",
    "                stop_server(container, cfg)",
    "                boot = start_server(container, cfg, f\"{cdir}/server_r{r}_a{attempt}.log\", a.boot_timeout)",
    "                log(f\"replay {r}: server healthy in {boot:.0f} s\")",
    "                dexec(container, f\"mkdir -p {cdir}/r{r}\")",
    "                extra = {\"CONCURRENCY\": cfg[\"concurrency\"], \"NUM_PROMPTS\": cfg[\"num_prompts\"],",
    "                         \"BENCH_OUTPUT\": f\"{cdir}/r{r}/bench_output.json\", \"DURATION\": a.duration}",
    "                if a.unsafe_override:",
    "                    extra[\"AIPERF_UNSAFE_OVERRIDE\"] = \"true\"",
    "                t0 = time.time()",
    "                rc = run_script(container, cfg, cfg[\"bench_script\"], extra, bench_timeout)",
    "                res = json.load(open(host_dir / f\"r{r}\" / \"bench_output.json\"))",
    "                res[\"bench_wall_s\"] = round(time.time() - t0, 1)",
    "                if rc != 0 or res.get(\"status\") != \"ok\":",
    "                    raise RuntimeError(f\"bench: rc={rc} status={res.get('status')}\")",
    "                runs.append(res[primary])",
    "                runs_sec.append(res.get(secondary) if secondary else None)",
    "                boots.append(round(boot, 1))",
    "                details.append(res)",
    "                log(f\"replay {r}: {primary}={res[primary]:.2f}, {secondary}={res.get(secondary)}, \"",
    "                    f\"bench wall {res['bench_wall_s']:.0f} s\")",
    "                if r == 1 and a.gsm8k:",
    "                    t0 = time.time()",
    "                    run_script(container, cfg, cfg[\"correctness_script\"], {",
    "                        \"CORRECTNESS_OUTPUT\": f\"{cdir}/correctness.json\", \"GSM8K_LIMIT\": a.gsm8k,",
    "                        \"GSM8K_MIN\": 0.0}, 7200)",
    "                    correctness = json.load(open(host_dir / \"correctness.json\"))",
    "                    correctness[\"wall_s\"] = round(time.time() - t0, 1)",
    "                    log(f\"correctness ({a.gsm8k} GSM8K questions): {correctness}\")",
    "                break",
    "            except Exception as exc:  # noqa: BLE001 - one retry per replay",
    "                log(f\"replay {r} attempt {attempt} failed: {exc}\")",
    "                if attempt == 2:",
    "                    stop_server(container, cfg)",
    "                    return 1",
    "        stop_server(container, cfg)",
    "",
    "    sec = [v for v in runs_sec if isinstance(v, (int, float))]",
    "    mean = statistics.fmean(runs)",
    "    rec = {",
    "        \"metric\": primary, \"secondary_metric\": secondary,",
    "        \"runs\": runs, \"mean\": round(mean, 5), \"median\": round(statistics.median(runs), 5),",
    "        \"weakest\": min(runs), \"best\": max(runs),",
    "        \"relative_spread\": round((max(runs) - min(runs)) / mean, 5) if len(runs) > 1 else 0.0,",
    "        \"runs_secondary\": sec,",
    "        \"mean_secondary\": round(statistics.fmean(sec), 5) if sec else None,",
    "        \"relative_spread_secondary\": (round((max(sec) - min(sec)) / statistics.fmean(sec), 5)",
    "                                      if len(sec) > 1 else 0.0),",
    "        \"duration_s\": a.duration, \"concurrency\": cfg[\"concurrency\"],",
    "        \"server_boot_s\": boots, \"correctness\": correctness,",
    "        \"node\": socket.gethostname(), \"job\": os.environ.get(\"SLURM_JOB_ID\"),",
    "        \"date\": time.strftime(\"%Y-%m-%dT%H:%M:%S%z\"), \"replays\": details,",
    "        \"_method\": f\"{len(runs)} COLD replays (server restarted before each), AgentX C{cfg['concurrency']}, \"",
    "                   f\"DURATION {a.duration} s, launch = arbor.frameworks launch_cmd of {a.config}\",",
    "    }",
    "    Path(a.out).parent.mkdir(parents=True, exist_ok=True)",
    "    tmp = a.out + \".tmp\"",
    "    json.dump(rec, open(tmp, \"w\"), indent=2)",
    "    os.replace(tmp, a.out)",
    "    log(f\"{primary}: mean {rec['mean']} (spread {100 * rec['relative_spread']:.2f}%); \"",
    "        f\"{secondary}: mean {rec['mean_secondary']} (spread {100 * rec['relative_spread_secondary']:.2f}%) -> {a.out}\")",
    "    return 0",
    "",
    "",
    "if __name__ == \"__main__\":",
    "    sys.exit(main())"
   ]
  }
 ]
}
